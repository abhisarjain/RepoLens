# PostgreSQL container
POSTGRES_DB=repolens
POSTGRES_USER=repolens
POSTGRES_PASSWORD=repolens
POSTGRES_PORT=55432

# Spring Boot API
DB_URL=jdbc:postgresql://localhost:55432/repolens
DB_USERNAME=repolens
DB_PASSWORD=repolens
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE=5MB
MAX_UPLOAD_BYTES=5242880

# React/Vite client
# Keep /api when using the Vite development proxy. Set an absolute URL when
# the frontend and API are hosted on different origins.
VITE_API_URL=/api
